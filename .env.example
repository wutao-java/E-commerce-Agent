# server
# 服务在 API 文档等位置展示的名称。
SERVICE_NAME=e-commerce-agent
# HTTP 服务监听地址；127.0.0.1 仅允许本机访问。
SERVER_HOST=127.0.0.1
# HTTP 服务监听端口。
SERVER_PORT=8000
# 应用日志级别。
LOG_LEVEL=INFO
# 轮转日志文件路径；留空时仅输出控制台日志。
LOG_FILE=/logs
# 外部集成预留开关，当前未绑定具体集成。
START_INTEGRATIONS=false

# LLM
# 调用大模型服务使用的 API 密钥。
AGENT_OPENAI_API_KEY=
# OpenAI 兼容接口的基础地址。
AGENT_OPENAI_BASE_URL=https://api.deepseek.com
# 客服 Agent 使用的大模型名称。
AGENT_OPENAI_MODEL=deepseek-v4-pro
# 大模型请求超时时间，单位为秒。
AGENT_OPENAI_TIMEOUT_SECONDS=30

# 课程知识沙箱：仅本地隔离演练时打开，不接入真实商城流量。
COURSE_RAG_ENABLED=false
COURSE_RAG_EMBEDDING_API_KEY=
COURSE_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
COURSE_RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
COURSE_RAG_MILVUS_URI=http://127.0.0.1:19530
COURSE_RAG_MILVUS_TOKEN=
COURSE_RAG_COLLECTION_PREFIX=course_rag
# 课程 2026 春季案例可设为 2026-03-15；留空表示今天。
COURSE_RAG_AS_OF_DATE=
# 可选商业 reranker；未配置时使用课程轻量重排。
COURSE_RAG_RERANK_BASE_URL=
COURSE_RAG_RERANK_MODEL=
COURSE_RAG_RERANK_API_KEY=

# MySQL
# MySQL 数据库连接地址。
DATABASE_URL=
# 数据库连接池常驻连接数。
DATABASE_POOL_SIZE=10
# 连接池允许临时增加的最大连接数。
DATABASE_MAX_OVERFLOW=20
# 从连接池获取连接的最长等待时间，单位为秒。
DATABASE_POOL_TIMEOUT=30
# 连接回收间隔，单位为秒。
DATABASE_POOL_RECYCLE=1800
# 是否打印数据库执行的 SQL。
DATABASE_ECHO=false

# JWT
# JWT 签名使用的私钥。
JWT_PRIVATE_KEY=
# JWT 验签使用的公钥。
JWT_PUBLIC_KEY=
# JWT 签名算法。
JWT_ALGORITHM=RS256
# JWT 默认有效期，单位为分钟。
JWT_EXPIRE_MINUTES=60
