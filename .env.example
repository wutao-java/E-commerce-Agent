# server
# 服务在 API 文档等位置展示的名称。
SERVICE_NAME=e-commerce-agent
# HTTP 服务监听地址；127.0.0.1 仅允许本机访问。
SERVER_HOST=127.0.0.1
# HTTP 服务监听端口。
SERVER_PORT=8000
# 应用日志级别。
LOG_LEVEL=INFO
# 轮转日志文件路径；留空时仅输出控制台日志。
LOG_FILE=/logs
# 外部集成预留开关，当前未绑定具体集成。
START_INTEGRATIONS=false

# LLM
# 调用大模型服务使用的 API 密钥。
AGENT_OPENAI_API_KEY=
# OpenAI 兼容接口的基础地址。
AGENT_OPENAI_BASE_URL=https://api.deepseek.com
# 客服 Agent 使用的大模型名称。
AGENT_OPENAI_MODEL=deepseek-v4-pro
# 大模型请求超时时间，单位为秒。
AGENT_OPENAI_TIMEOUT_SECONDS=30

# MySQL
# MySQL 数据库连接地址。
DATABASE_URL=
# 数据库连接池常驻连接数。
DATABASE_POOL_SIZE=10
# 连接池允许临时增加的最大连接数。
DATABASE_MAX_OVERFLOW=20
# 从连接池获取连接的最长等待时间，单位为秒。
DATABASE_POOL_TIMEOUT=30
# 连接回收间隔，单位为秒。
DATABASE_POOL_RECYCLE=1800
# 是否打印数据库执行的 SQL。
DATABASE_ECHO=false

# RAG（填写百炼业务空间接口；留空时不启用该外部能力）
# 调用百炼服务使用的 API 密钥。
BAILIAN_API_KEY=
# 百炼业务空间的文本向量接口地址。
BAILIAN_EMBEDDING_ENDPOINT=
# 百炼业务空间的重排接口地址。
BAILIAN_RERANK_ENDPOINT=
# 生成文本向量使用的模型名称。
BAILIAN_EMBEDDING_MODEL=qwen3.7-text-embedding
# 文本向量的维度，须与所选模型及 Milvus 集合一致。
RAG_EMBEDDING_DIMENSION=1024
# Milvus 服务连接地址。
MILVUS_URI=
# Milvus 连接令牌；无需认证时可留空。
MILVUS_TOKEN=
# 是否在服务启动时准备待审核知识快照。
RAG_PREPARE_ON_START=true

# JWT
# JWT 签名使用的私钥。
JWT_PRIVATE_KEY=
# JWT 验签使用的公钥。
JWT_PUBLIC_KEY=
# JWT 签名算法。
JWT_ALGORITHM=RS256
# JWT 默认有效期，单位为分钟。
JWT_EXPIRE_MINUTES=60
